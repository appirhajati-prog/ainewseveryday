# ============================================
# تنظیمات ربات اخبار هوش مصنوعی
# این فایل را کپی کرده و نام آن را به .env تغییر دهید
# ============================================

# توکن ربات تلگرام - از BotFather دریافت کنید
TELEGRAM_TOKEN=your_telegram_bot_token_here

# شناسه چت تلگرام (Channel ID یا Chat ID)
CHAT_ID=your_chat_id_here

# حداکثر تعداد اخبار در هر دیجست (پیش‌فرض: 15)
MAX_DIGEST_ITEMS=15

# تایم‌اوت درخواست‌ها به ثانیه (پیش‌فرض: 15)
REQUEST_TIMEOUT=15